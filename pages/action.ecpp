<%pre>
// Do not write an ecpp comment into this file. It must produce no
// HTML output not even an empty line.

#include <exception.h>
#include <tools.h>
#include <users.h>
#include <recman.h>
#include <confirm.h>

using namespace vdrlive;

</%pre>
<%args>
  std::string id;  // action ID, what needs to be done
</%args>
<%include>page.eh</%include>
<& login.authentication &><%cpp>
// there must be no newline after <& login.authentication &> (before <%cpp>),
// otherwise there will be a newline in the output, which will break the resulting XML file

  const cConfirm *confirm = get_confirm_popup(id);
  if (!confirm) {
    cToSvConcat error_message("pages/action.ecpp, no action found for ID \"", id, "\"");
    esyslog2(error_message);
    throw HtmlError(error_message.c_str() );
  }

  if (!confirm->currentUserHasRight() ) {
    esyslog2("pages/action.ecpp, no authorization for ", id);
    throw HtmlError( tr("Sorry, no permission. Please contact your administrator!") );
  }

  reply.setContentType("application/json");
</%cpp>
<$$ confirm->perform_action(id) $>
<#
{
  "success": <$result == 0?"true":"false"$>,
  "message": <$ cToSvStringEscapedAndCorrectNonUTF8(message) $>
}
#>
