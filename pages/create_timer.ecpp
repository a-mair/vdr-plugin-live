<%pre>
// Do not write an ecpp comment into this file. It must produce no
// HTML output not even an empty line.

#include <exception.h>
#include <tools.h>
#include <users.h>
#include "setup.h"
#include "timers.h"
#include "confirm.h"

using namespace vdrlive;

</%pre>
<%args>
  std::string epgid;  // create timer for this epg event
</%args>
<%include>page.eh</%include>
<& login.authentication &><%cpp>
// there must be no newline after <& login.authentication &> (before <%cpp>),
// otherwise there will be a newline in the output, which will break the resulting XML file

  if (!cUser::CurrentUserHasRightTo(UR_EDITTIMERS))
    throw HtmlError( tr("Sorry, no permission. Please contact your administrator!") );

  cToSvConcat message;
  int result = TimerManager_CreateTimer(epgid);
  switch (result) {
    case 1: message.concat("event ", epgid, " not found"); break;
    case 2: message.concat("timer already exists for epgid ", epgid); break;
    case 3: message.concat("error handling timer on remote server, epgid ", epgid); break;
    default: break;
  }

reply.setContentType("application/json");
</%cpp>
<$$ simpleJsonReturn(result == 0, message) $>
