<%pre>
// Do not write an ecpp comment into this file. It must produce no
// HTML output not even an empty line.

#include <unistd.h>
#include <setup.h>
#include <users.h>
#include <exception.h>
#include <recman.h>
#include <vdr/menu.h>

inline bool is_in_command_list(cList<cNestedItem> *commands, cSv text) {
  for (cNestedItem *Command = commands->First(); Command; Command = commands->Next(Command)) {
    if (Command->SubItems()) {
      bool in_sublist = is_in_command_list(Command->SubItems(), text);
      if (in_sublist) return true;
    } else if (text == Command->Text()) return true;
  }
  return false;
}

using namespace vdrlive;

</%pre>
<%args>
  std::string recid;
  std::string text;
</%args>
<%include>page.eh</%include>
<& login.authentication &><%cpp>
// there must be no newline after <& login.authentication &> (before <%cpp>),
// otherwise there will be a newline in the output, which will break the resulting XML file

if (!cUser::CurrentUserHasRightTo(UR_EDITRECS))
  throw HtmlError(tr("Sorry, no permission. Please contact your administrator!") );

// security check to prevent execution of arbitrary commands
if (!is_in_command_list(&RecordingCommands, text)) {
  esyslog2("recording_command.ecpp, text \"", text, "\" not in reccommands list. Someone might try to attack your system");
  throw HtmlError(tr("Sorry, no permission. Please contact your administrator!") );
}

size_t command_pos = text.find(':');
if (command_pos == std::string::npos) {
  esyslog2("recording_command.ecpp, text \"", text, "\" invalid: ':' missing");
  throw HtmlError(tr("Couldn't find recording or no recordings available"));
}
cToSvConcat command(trim(cSv(text).substr(command_pos+1)));
{
  LOCK_RECORDINGS_READ;
  const cRecording *recording = RecordingsManager::GetByHash(RecordingsManager::GetHash(recid), Recordings);
  if (!recording) {
    esyslog2("recording_command.ecpp, recording with recid ", recid, " not found");
    throw HtmlError(tr("Couldn't find recording or no recordings available"));
  }
// cString::sprintf("\"%s\"", *strescape(ri->Recording()->FileName(), "\\\"$"))));
  cToSvConcat rec_filename(recording->FileName());
  rec_filename.replaceAll('\\', "\\\\");
  rec_filename.replaceAll('"', "\\\"");
  rec_filename.replaceAll('$', "\\$");
  command << " \"" << rec_filename << '"';
}
isyslog2("recording_command.ecpp, executing ", command);

cToSvConcat result;
cPipe p;
if (p.Open(command.c_str(), "r")) {
  int c;
  while ((c = fgetc(p)) != EOF) result << (char)c;
  p.Close();
} else {
  esyslog2("recording_command.ecpp, opening pipe for command \"", command, "\" failed");
  result.concat("error opening pipe for command \"", command, "\"");
}
dsyslog2("recording_command.ecpp, result = \"", result, "\"");

cToSvConcat html_result;
AppendHtmlEscapedAndCorrectNonUTF8(html_result, result);
reply.setContentType("text/plain");
</%cpp>
<# <$cToSvFormatted(tr("Result from command %s"), text.substr(0, command_pos).c_str())$><br/> #>
<b><$trim(cSv(text).substr(0, command_pos))$></b><br/>
<$$html_result$>
