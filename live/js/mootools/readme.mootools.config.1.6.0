====== pick  ===============================================
var epgid = [href, ""].pick();
Function: $pick
  Returns the first object if defined, otherwise returns the second.

====== $defined  ===============================================
var $defined = function(obj){
    return (obj != undefined);
};

// or just use it like this:
if(obj != undefined){
    // do something
}
